# 本地开发默认使用 SQLite，无需任何安装配置，开箱即用：
DATABASE_URL="file:./dev.db"

# 部署到云端（Supabase / Neon / PostgreSQL）时，只需填入云端数据库连接串，并将 schema.prisma 的 provider 改为 postgresql 即可：
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?schema=public"

# 家长端访问保护口令（可选，留空则免密，生产环境推荐设置4-6位数字PIN码）
PARENT_PIN=""
